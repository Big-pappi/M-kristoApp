# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL connection string (django-environ db() format)
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mkristo

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Phone OTP provider (fill in once chosen, e.g. an SMS gateway for Tanzania)
OTP_SMS_PROVIDER_API_KEY=

# Push notifications
FCM_SERVER_KEY=
